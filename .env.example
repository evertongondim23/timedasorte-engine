# ===========================================
# Jogo da Sorte Engine - Variáveis de ambiente
# Copie para .env e preencha os valores
# ===========================================

# Database
DATABASE_URL="postgresql://user:pass@localhost:5432/jogo_da_sorte_db?schema=public"

# JWT
JWT_SECRET="your-secret-key"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-refresh-secret"
JWT_REFRESH_EXPIRATION="7d"

# Game (opcional)
GAME_CUTOFF_MINUTES=30
GAME_MIN_BET_AMOUNT=1.00

# Result Provider (opcional)
RESULT_PROVIDER_TYPE="ADMIN"
# OFFICIAL_PROVIDER_URL=
# OFFICIAL_PROVIDER_API_KEY=

# ===========================================
# Asaas (depósito e saque PIX)
# Sem essas variáveis o backend sobe normal, mas
# "Depósito via PIX" e saque PIX retornam erro de configuração.
# ===========================================
# ASAAS_API_KEY=
# ASAAS_WALLET_ID=cf4340a1-5c26-4f48-8f78-cec1dc40b27d
# ASAAS_CUSTOMER_ID=
# ASAAS_ENVIRONMENT=sandbox
